rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check: In this app, we assume the creator or anyone in the 'admins' collection is an admin
    // For simplicity in this demo, we allow anyone signed in to be an admin IF they are accessing admin routes.
    // In a real app, you'd check: exists(/databases/$(database)/documents/admins/$(request.auth.uid))
    // We'll use a bootstrap email from metadata or just common emails if needed.
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('.*@gm\\.nssh\\.ntpc\\.edu\\.tw$')
      );
    }

    // Categories
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidCategory(incoming());
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50
          && data.order is number;
    }

    // Products
    match /products/{prodId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidProduct(incoming());
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.price is number && data.price >= 0
          && data.categoryId is string;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin(); // Only admins can see all orders
      allow create: if isValidOrder(incoming());
      allow update: if isAdmin() && (
        // Action: Change Status
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
    }

    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0 && data.items.size() <= 50
          && data.total is number && data.total >= 0
          && data.status in ['pending', 'preparing', 'completed', 'cancelled']
          && data.createdAt is timestamp;
    }

    // Admin List
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // Only manageable via console
    }
  }
}
